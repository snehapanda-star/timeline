// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MENTOR
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MilestoneStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ProgressLogType {
  HOURS
  MILESTONE
  SKILL_LEVEL
  NOTE
}

enum CoachingSessionType {
  CHAT
  QUESTION_ANSWER
  PLAN_UPDATE
}

enum RecommendationType {
  SKILL
  RESOURCE
  TASK
  PATHWAY
  HABIT
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]

  goals         Goal[]
  coaching      CoachingSession[]
  progressLogs  ProgressLog[]
  notifications Notification[]

  streaks       Streak[]
  userBadges    UserBadge[]

  mentorLinks   MentorLink[] @relation("MentorLinks")
  menteeLinks   MentorLink[] @relation("MenteeLinks")

  @@index([role])
}

// NextAuth models (minimal, compatible with @auth/prisma-adapter)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Goal {
  id                 String   @id @default(cuid())
  userId             String
  title              String
  description        String
  targetCompletionDate DateTime?
  weeklyAvailabilityHours Int
  budgetConstraints  String?
  obstacles          String?
  interests          String?
  preferredLearningStyles String?
  educationLevel     String?
  experienceLevel    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  difficulty         Difficulty?
  timelineHealthScore Int? // 0-100
  optimizationNotes  String?

  stages             TimelineStage[]
  milestones         Milestone[]
  skillAssessments   SkillAssessment[]
  resources          Resource[]
  recommendations    Recommendation[]
  progressLogs       ProgressLog[]
  notifications       Notification[]

  coachingSessions   CoachingSession[]
  milestoneDependencies MilestoneDependency[]
  userBadges         UserBadge[]
  streaks            Streak[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TimelineStage {
  id          String   @id @default(cuid())
  goalId      String
  name        String
  objective   String
  orderIndex  Int
  estimatedDurationWeeks Int
  difficulty  Difficulty?
  successMetrics String?
  resources   String?
  createdAt   DateTime @default(now())

  goal        Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@unique([goalId, orderIndex])
  @@index([goalId, orderIndex])
}

model Milestone {
  id            String   @id @default(cuid())
  goalId        String
  stageId       String?
  title         String
  description   String?
  orderIndex    Int
  estimatedDurationWeeks Int
  importance    Int? // 1-5
  difficulty    Difficulty?
  successMetrics String?
  expectedOutcome String?

  status        MilestoneStatus @default(TODO)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualCompletionDate DateTime?

  dependencies  MilestoneDependency[] @relation("MilestoneDependencies")
  dependents    MilestoneDependency[] @relation("MilestoneDependents")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goal          Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  stage         TimelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  tasks         Task[]
  progressLogs ProgressLog[]

  @@index([goalId, orderIndex])
}

model MilestoneDependency {
  id            String @id @default(cuid())
  goalId        String
  prerequisiteMilestoneId String
  dependentMilestoneId    String

  createdAt     DateTime @default(now())

  prerequisite Milestone @relation("MilestoneDependencies", fields: [prerequisiteMilestoneId], references: [id], onDelete: Cascade)
  dependent    Milestone @relation("MilestoneDependents", fields: [dependentMilestoneId], references: [id], onDelete: Cascade)
  goal          Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([prerequisiteMilestoneId, dependentMilestoneId])
  @@index([goalId])
}

model Task {
  id          String @id @default(cuid())
  milestoneId String
  title       String
  description String?
  orderIndex  Int
  estimatedHours Int?
  difficulty  Difficulty?
  resources   String?
  successMetrics String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  progressLogs ProgressLog[]

  @@index([milestoneId, orderIndex])
}

model Skill {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  createdAt   DateTime @default(now())

  assessments SkillAssessment[]
  recommendations Recommendation[]
}

model SkillAssessment {
  id          String @id @default(cuid())
  goalId      String
  skillId     String
  proficiency Int // 0-100
  whyItMatters String?
  targetProficiency Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal        Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  skill       Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([goalId, skillId])
}

model ProgressLog {
  id          String @id @default(cuid())
  userId      String
  goalId      String
  milestoneId String?
  taskId      String?
  type        ProgressLogType
  hoursSpent Int?
  milestoneStatus MilestoneStatus?
  skillId     String?
  skillLevel  Int?
  note        String?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  task        Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, goalId, createdAt])
}

model CoachingSession {
  id          String @id @default(cuid())
  userId      String
  goalId      String?
  type        CoachingSessionType
  prompt      String
  response    String
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Resource {
  id          String @id @default(cuid())
  goalId      String
  title       String
  url         String?
  description String?
  createdAt   DateTime @default(now())

  goal        Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id          String @id @default(cuid())
  goalId      String
  skillId     String?
  type        RecommendationType
  title       String
  details     String
  createdAt   DateTime @default(now())

  goal        Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  skill       Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([goalId, type])
}

model MentorLink {
  id        String @id @default(cuid())
  mentorId  String
  menteeId  String
  createdAt DateTime @default(now())

  mentor    User @relation("MentorLinks", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    User @relation("MenteeLinks", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
  @@index([menteeId])
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String @id @default(cuid())
  userId    String
  badgeId   String
  goalId    String?
  earnedAt  DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  goal      Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId, goalId])
}

model Streak {
  id        String @id @default(cuid())
  userId    String
  goalId    String?
  currentCount Int @default(0)
  bestCount Int @default(0)
  lastActiveDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@unique([userId, goalId])
}

model Notification {
  id          String @id @default(cuid())
  userId      String
  goalId      String?
  channel     NotificationChannel
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
}
